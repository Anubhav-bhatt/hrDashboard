datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Recruiter / HR administrator account used for dashboard authentication.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String    @default("Recruiter")
  role         String    @default("RECRUITER") // RECRUITER | ADMIN
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notes            CandidateNote[]
  activities       CandidateActivity[]
  closedJobs       Job[]               @relation("JobClosedBy")
  selectedHires    Candidate[]         @relation("CandidateSelectedBy")
  authSessions     AuthSession[]
  memberships      WorkspaceMember[]
}

/// Persisted recruitment lifecycle of a vacancy. Deliberately minimal: a job is
/// either being worked or it has been filled and closed. This is separate from
/// the processing state shown on job cards (New / Importing / Ready to score /
/// All scored), which is derived from candidate counts and not stored.
enum JobStatus {
  OPEN
  CLOSED
}

model Job {
  id                 String          @id @default(uuid())

  /// Owning workspace. This is the single authority for who may see a job and,
  /// through it, every candidate, note, activity and import that hangs off it.
  workspaceId        String
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  title              String
  jdFileName         String
  jdMimeType         String
  jdText             String          @db.Text
  requiredSkills     String[]
  preferredSkills    String[]
  roleKeywords       String[]
  minimumExperience  Float?          @default(0)
  maximumExperience  Float?
  salaryMin          Float?
  salaryMax          Float?
  salaryCurrency     String?         @default("INR")
  preferredLocations String[]
  qualifications     String[]
  searchKeywords     String[]
  preferredEducation String[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  /// Every existing job becomes OPEN, so the addition is backwards-compatible.
  status             JobStatus       @default(OPEN)

  /// The candidate hired for this vacancy, recorded on the job so closed-job
  /// listings do not have to search candidates by status. Unique because a
  /// vacancy has exactly one hire.
  selectedCandidateId String?        @unique
  selectedCandidate   Candidate?     @relation("JobSelectedCandidate", fields: [selectedCandidateId], references: [id], onDelete: SetNull)

  closedAt           DateTime?
  /// Recruiter who closed the job, kept as a stable identifier rather than an
  /// email so the reference survives an address change.
  closedByUserId     String?
  closedBy           User?           @relation("JobClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  candidates         Candidate[]     @relation("JobCandidates")
  importSessions     ImportSession[]

  /// Closed-job history is listed by recency, and the portal filters by status.
  @@index([status])
  @@index([status, closedAt])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model Candidate {
  id                     String    @id @default(uuid())
  jobId                  String
  job                    Job       @relation("JobCandidates", fields: [jobId], references: [id], onDelete: Cascade)

  name                   String?   @default("Unknown Candidate")
  nameSource             String?   @default("unknown")
  email                  String?
  phone                  String?
  currentRole            String?
  totalExperience        Float?
  currentLocation        String?
  preferredLocations     String[]
  currentSalary          Float?
  expectedSalary         Float?
  qualification          String?

  // Contact & web presence parsed from the resume (null when the resume does not provide it)
  alternateEmail         String?
  alternatePhone         String?
  linkedinUrl            String?
  githubUrl              String?
  portfolioUrl           String?

  // Professional headline & summary text taken verbatim from the resume
  headline               String?
  summary                String?   @db.Text

  skills                 String[]
  education              String[]
  projects               String[]
  resumeText             String?   @db.Text

  /// Structured resume sections (experience, education, projects, certifications,
  /// languages, achievements) produced by services/resumeProfileParser.js.
  parsedProfile          Json?

  source                 String    @default("OUTLOOK")
  sourceRelativePath     String?
  outlookMessageId       String
  outlookAttachmentId    String
  resumeFileName         String?   @default("resume.pdf")
  resumeMimeType         String?   @default("application/pdf")
  resumeHash             String?
  receivedAt             DateTime? @default(now())

  /// Original resume bytes. Required so recruiters can open/download the real
  /// document for candidates that were uploaded directly (not fetched live from
  /// Outlook). Excluded from every list query — only streamed by the resume route.
  resumeData             Bytes?
  resumeSize             Int?

  extractionStatus       String    @default("SUCCESS")
  extractionWarnings     String[]

  overallScore           Float?
  alignmentLabel         String?
  requiredSkillScore     Float?
  experienceScore        Float?
  roleScore              Float?
  preferredSkillScore    Float?
  projectScore           Float?
  educationScore         Float?

  matchedSkills          String[]
  missingRequiredSkills  String[]
  matchedPreferredSkills String[]
  matchedKeywords        String[]
  strengths              String[]
  gaps                   String[]
  analysisSummary        String?   @db.Text
  analyzedAt             DateTime?

  /// REVIEW | SHORTLISTED | NEEDS_REVIEW | NOT_SUITABLE | SELECTED.
  /// SELECTED means hired for the vacancy and is only ever set by closing a job;
  /// it is deliberately distinct from SHORTLISTED (still under consideration).
  hrStatus               String    @default("REVIEW")
  notes                  String?   @db.Text

  /// Set when the candidate is chosen as the hire during job closure.
  selectedAt             DateTime?
  selectedByUserId       String?
  selectedBy             User?     @relation("CandidateSelectedBy", fields: [selectedByUserId], references: [id], onDelete: SetNull)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  noteEntries            CandidateNote[]
  activities             CandidateActivity[]
  /// Back-relation for Job.selectedCandidate. A candidate is the hire for at
  /// most one job, which the unique FK on Job enforces.
  selectedForJob         Job?      @relation("JobSelectedCandidate")

  @@unique([jobId, outlookMessageId, outlookAttachmentId])
  @@unique([jobId, resumeHash])
  @@index([jobId])
  @@index([jobId, overallScore])
  @@index([hrStatus])
  @@index([createdAt])
  /// Job-scoped status lookups: the closure dialog lists shortlisted candidates
  /// for one job, and closed-job cards count by status.
  @@index([jobId, hrStatus])
}

/// Timestamped recruiter note attached to a candidate.
model CandidateNote {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String    @default("Recruiter")
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

/// Append-only recruitment activity trail (status changes, notes, analysis runs,
/// resume access). Never stores resume contents or full contact details.
model CandidateActivity {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName   String    @default("System")
  type        String // IMPORTED | STATUS_CHANGED | NOTE_ADDED | ANALYZED | RESUME_VIEWED
  description String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([candidateId, createdAt])
}

model OutlookConnection {
  id              String    @id @default(uuid())

  /// The mailbox connection belongs to one workspace. Without this, any signed-in
  /// user could browse, search and import from another workspace's mailbox.
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  microsoftUserId String    @unique
  email           String
  displayName     String?   @default("")
  accessToken     String?   @db.Text
  refreshToken    String?   @db.Text
  expiresAt       DateTime?
  connectedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
}

model ImportSession {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  folderId     String
  folderName   String?
  fromDate     DateTime
  toDate       DateTime
  emailsFound  Int      @default(0)
  resumesFound Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Server-side refresh session: one row per issued refresh token.
///
/// The refresh token itself is opaque and random; only its SHA-256 is stored, so
/// a database disclosure does not hand anyone a usable session. Rows are kept
/// after rotation rather than deleted — a revoked row is what lets a replayed
/// token be recognised as reuse instead of simply being unknown.
model AuthSession {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 (hex) of the opaque refresh token. The raw token is never stored.
  refreshTokenHash String   @unique

  /// Every token minted from one sign-in shares a familyId, so a detected reuse
  /// can revoke the whole lineage rather than the single replayed token.
  familyId     String
  /// The session this one was rotated into, forming the lineage chain.
  replacedById String?      @unique
  replacedBy   AuthSession? @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     AuthSession? @relation("SessionRotation")

  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime  @default(now())
  revokedAt     DateTime?
  /// ROTATED | LOGOUT | REUSE_DETECTED. Operational only — never a token value.
  revokedReason String?

  /// A coarse client hint for session review. Deliberately not fingerprinting:
  /// a truncated user agent and nothing else.
  userAgent String?

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// A tenant boundary: one hiring team's jobs, candidates and mailbox connection.
///
/// Created automatically when someone signs up, so a recruiter never has to
/// understand tenancy to use the product. Everything a workspace owns hangs off
/// `Job.workspaceId` — candidates, notes, activities and imports are reached
/// through their job rather than carrying a copy of the owner, so there is one
/// authority for who may see a record and no denormalised field to drift.
model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            WorkspaceMember[]
  jobs               Job[]
  outlookConnections OutlookConnection[]
}

/// Which people may act inside a workspace, and in what capacity.
///
/// `role` is the workspace role (OWNER for whoever created it) and is separate
/// from `User.role`, which stays the application-wide role. A person could
/// belong to more than one workspace later; today signup creates exactly one.
model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// OWNER | MEMBER
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}
