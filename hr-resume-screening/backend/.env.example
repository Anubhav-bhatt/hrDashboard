NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_screening?schema=public"

# Comma-separated list of browser origins allowed to call this API.
# Required in production — the API refuses to start without it.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secret for session tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=12

# First recruiter account, created automatically when the users table is empty.
# Use `npm run seed:user -- email password "Name" ADMIN` to add more accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HR Administrator

# Request throttling
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=20

# Set to true when running behind a reverse proxy (nginx, Render, Heroku)
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Microsoft Outlook OAuth 2.0 (optional — candidate upload works without it)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/outlook/callback

# ---------------------------------------------------------------------------
# Processing Settings
# ---------------------------------------------------------------------------
MAX_EMAIL_IMPORT=2000
MIN_RESUME_TEXT_LENGTH=100
RESUME_PROCESS_CONCURRENCY=5
MATCH_PROCESS_CONCURRENCY=10
MAX_RESUME_SIZE_MB=10
MAX_BULK_RESUME_FILES=2000

# Retain original resume bytes so recruiters can open/download the real file.
# Set to false to keep only extracted text (the resume viewer is then disabled).
STORE_RESUME_BLOB=true

# Optional AI Key for text summaries (Backend operates 100% deterministically without this)
# Note: when GEMINI_API_KEY is set, services/candidateInsightService.js replaces the
# deterministic candidate summary with a generated one. Scores are never affected.
# Leave it empty to keep the summary deterministic.
AI_PROVIDER=none
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# AI Recruitment Agents — reserved, OFF, and not yet read by any code.
# ---------------------------------------------------------------------------
# Declared here in Phase 0 so the contract is fixed before the AI layer exists:
# AI is an additive, optional layer, and AI_ENABLED=false must leave the
# application behaving exactly as it does today. Nothing in the codebase reads
# these yet — a Phase 1 config module will, and it must treat an absent value as
# false so an existing deployment that never adds them stays unchanged.
#
# AI_ENABLED is the master switch: when it is false the individual agent flags
# below are ignored, whatever they are set to.
AI_ENABLED=false
AI_ASSISTANT_ENABLED=false
AI_SCREENING_ENABLED=false
AI_RANKING_ENABLED=false
AI_COMPARISON_ENABLED=false
AI_INSIGHTS_ENABLED=false
