NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_screening?schema=public"

# Comma-separated list of browser origins allowed to call this API.
# Required in production — the API refuses to start without it.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secret for session tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=12

# First recruiter account, created automatically when the users table is empty.
# Use `npm run seed:user -- email password "Name" ADMIN` to add more accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HR Administrator

# Request throttling
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=20

# Set to true when running behind a reverse proxy (nginx, Render, Heroku)
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Microsoft Outlook OAuth 2.0 (optional — candidate upload works without it)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/outlook/callback

# ---------------------------------------------------------------------------
# Processing Settings
# ---------------------------------------------------------------------------
MAX_EMAIL_IMPORT=2000
MIN_RESUME_TEXT_LENGTH=100
RESUME_PROCESS_CONCURRENCY=5
MATCH_PROCESS_CONCURRENCY=10
MAX_RESUME_SIZE_MB=10
MAX_BULK_RESUME_FILES=2000

# Retain original resume bytes so recruiters can open/download the real file.
# Set to false to keep only extracted text (the resume viewer is then disabled).
STORE_RESUME_BLOB=true

# Legacy optional Gemini summary key. Unrelated to the AI agent layer below and
# read only by services/candidateInsightService.js.
# Note: when GEMINI_API_KEY is set, that service replaces the deterministic
# candidate summary with a generated one. Scores are never affected.
# Leave it empty to keep the summary deterministic — this is the default.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# AI Recruitment Agents
# ---------------------------------------------------------------------------
# The AI layer is additive and optional. AI_ENABLED=false — the default, and what
# you get by leaving every variable below unset — means the application behaves
# exactly as it did before the layer existed. Every flag defaults to false, so an
# existing deployment that never adds any of them is unaffected.
#
# An unrecognised boolean (e.g. AI_ENABLED=ture) resolves to false rather than
# being guessed at, and is reported as a startup-time warning.
#
# AI_ENABLED is the master switch: when it is false the per-mode flags below are
# ignored, whatever they are set to.
AI_ENABLED=false

# Per-mode switches. Each agent mode is gated independently so one can be piloted
# without exposing the others. Every mode is read-only in this phase.
AI_ASSISTANT_ENABLED=false
AI_SCREENING_ENABLED=false
AI_RANKING_ENABLED=false
AI_COMPARISON_ENABLED=false
AI_INSIGHTS_ENABLED=false

# Which provider answers AI requests. Supported: mock, openai.
#   mock   — local, deterministic, zero network calls, no API key, no cost (DEFAULT).
#   openai — external model integration for natural language intent interpretation.
AI_PROVIDER=mock

# Provider execution mode:
#   mock   — deterministic mock execution (default).
#   shadow — deterministic execution is authoritative; real provider runs in shadow for telemetry evaluation.
#   live   — real provider interpretation drives structured intent when AI_REAL_PROVIDER_ENABLED=true.
AI_PROVIDER_MODE=mock
AI_REAL_PROVIDER_ENABLED=false

# Provider credentials and model configuration (required only when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=500

# Whether an agent may ever modify data. AI Assistant remains strictly read-only.
AI_WRITE_ACTIONS_ENABLED=false

# ---------------------------------------------------------------------------
# AI tool retrieval limits
# ---------------------------------------------------------------------------
# Ceilings on how much data one AI tool call may retrieve, so a single request
# can never pull the whole candidate table. Enforced today even though the
# provider is a mock — the limit needs to already exist before anything billed
# by the token is connected.
#
# A value that is not a positive integer is refused and the default below is used
# instead, with a warning. A default larger than its own maximum is reduced to
# the maximum.
#
# Note: candidate listings are additionally capped at 100 rows per page by the
# application's own pagination (MAX_LIMIT in utils/candidateQuery.js). The
# effective candidate ceiling is therefore the lower of that and the value here,
# and the tools report the effective figure rather than the configured one.
AI_TOOL_DEFAULT_CANDIDATE_LIMIT=50
AI_TOOL_MAX_CANDIDATE_LIMIT=200
AI_TOOL_DEFAULT_JOB_LIMIT=25
AI_TOOL_MAX_JOB_LIMIT=100
