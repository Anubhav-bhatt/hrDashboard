NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_screening?schema=public"

# Comma-separated list of browser origins allowed to call this API.
# Required in production — the API refuses to start without it.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing secret for session tokens. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=12

# First recruiter account, created automatically when the users table is empty.
# Use `npm run seed:user -- email password "Name" ADMIN` to add more accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=HR Administrator

# Request throttling
API_RATE_LIMIT=600
LOGIN_RATE_LIMIT=20

# Set to true when running behind a reverse proxy (nginx, Render, Heroku)
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Microsoft Outlook OAuth 2.0 (optional — candidate upload works without it)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/outlook/callback

# ---------------------------------------------------------------------------
# Processing Settings
# ---------------------------------------------------------------------------
MAX_EMAIL_IMPORT=2000
MIN_RESUME_TEXT_LENGTH=100
RESUME_PROCESS_CONCURRENCY=5
MATCH_PROCESS_CONCURRENCY=10
MAX_RESUME_SIZE_MB=10
MAX_BULK_RESUME_FILES=2000

# Retain original resume bytes so recruiters can open/download the real file.
# Set to false to keep only extracted text (the resume viewer is then disabled).
STORE_RESUME_BLOB=true

# Legacy optional Gemini summary key. Unrelated to the AI agent layer below and
# read only by services/candidateInsightService.js.
# Note: when GEMINI_API_KEY is set, that service replaces the deterministic
# candidate summary with a generated one. Scores are never affected.
# Leave it empty to keep the summary deterministic — this is the default.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# AI Recruitment Agents
# ---------------------------------------------------------------------------
# The AI layer is additive and optional. AI_ENABLED=false — the default, and what
# you get by leaving every variable below unset — means the application behaves
# exactly as it did before the layer existed. Every flag defaults to false, so an
# existing deployment that never adds any of them is unaffected.
#
# An unrecognised boolean (e.g. AI_ENABLED=ture) resolves to false rather than
# being guessed at, and is reported as a startup-time warning.
#
# AI_ENABLED is the master switch: when it is false the per-mode flags below are
# ignored, whatever they are set to.
AI_ENABLED=false

# Per-mode switches. Each agent mode is gated independently so one can be piloted
# without exposing the others. Every mode is read-only in this phase.
AI_ASSISTANT_ENABLED=false
AI_SCREENING_ENABLED=false
AI_RANKING_ENABLED=false
AI_COMPARISON_ENABLED=false
AI_INSIGHTS_ENABLED=false

# Which provider answers AI requests. Supported: mock.
#   mock — local, deterministic, zero network calls, no API key, no cost.
# A provider that is named but not implemented (openai, anthropic, gemini) is
# refused with a clear configuration error. There is deliberately no fallback: a
# misconfigured provider must never quietly become a paid one.
# No API key is required while AI_PROVIDER=mock.
AI_PROVIDER=mock

# Whether an agent may ever modify data. Independent of the flags above so that
# granting write access is always a deliberate act. No write-capable agent exists
# yet; leave this false.
AI_WRITE_ACTIONS_ENABLED=false
