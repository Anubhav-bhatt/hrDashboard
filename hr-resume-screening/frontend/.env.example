# Where the browser sends API requests.
#
# Recommended for local development:
#
#   VITE_API_URL=/api
#
# That routes through the Vite dev proxy (see vite.config.js), so the page and
# the API share an origin. Nothing here depends on your machine's IP address, and
# the session cookie — which is sameSite=lax — is always treated as same-site and
# sent. This is the setting to use if sign-in ever appears to hang.
#
# Avoid pointing this at a LAN IP such as http://192.168.1.50:5000/api. The
# address changes when the DHCP lease renews, and while the page is served from
# localhost the browser treats an IP-addressed API as cross-site and withholds
# the session cookie, which looks like a broken login rather than a stale config.
#
# An absolute URL still works and remains the default when this is unset. If you
# use one, the host must match the host the page is served from:
#
#   opening http://localhost:5173 -> http://localhost:5000/api
#
VITE_API_URL=/api

# Where the dev proxy forwards /api. Only needed if the backend is not on
# localhost:5000. Development only — production never runs the Vite server.
# VITE_DEV_API_PROXY=http://localhost:5000

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------
# Leave VITE_API_URL UNSET in the Vercel project.
#
# A production build with no value uses the relative path /api, which Vercel
# rewrites to the backend server-side (see vercel.json). The page and the API
# then share an origin, the auth cookies are first-party, and Safari stores
# them. Pointing this at the backend's own hostname is what broke Safari: a
# cross-site cookie is received and then silently discarded, so sign-in returns
# 200 and the very next request is 401.
#
# A cross-origin absolute URL in a production build is ignored (with a console
# warning) for that reason. To deliberately override:
#
#   VITE_ALLOW_CROSS_ORIGIN_API=true
